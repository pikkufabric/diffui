{
  "name": "@project/root",
  "version": "0.0.1",
  "private": true,
  "workspaces": [
    "apps/*",
    "packages/*",
    "design/*",
    "!apps/_app_template_"
  ],
  "scripts": {
    "prebuild": "cd packages/functions && bunx --bun pikku all",
    "build": "bun run --filter '*' --if-present build",
    "dev": "bun scripts/dev.mjs",
    "tsc": "bun run --filter '*' tsc",
    "lint": "oxlint apps packages",
    "format": "oxfmt apps packages",
    "format:check": "oxfmt --check apps packages"
  },
  "dependencies": {
    "@ai-sdk/openai": "^3.0.65",
    "@ai-sdk/openai-compatible": "^2.0.66",
    "@pikku/addon-admin": "^0.12.2",
    "@pikku/addon-console": "^0.12.50",
    "@pikku/ai-vercel": "^0.12.13",
    "@pikku/assistant-ui": "^0.12.12",
    "@pikku/better-auth": "^0.12.38",
    "@pikku/cloudflare": "^0.12.22",
    "@pikku/core": "0.12.104",
    "@pikku/fetch": "0.12.10",
    "@pikku/kysely": "^0.13.24",
    "@pikku/kysely-node-sqlite": "^0.12.7",
    "@pikku/kysely-sqlite": "^0.12.13",
    "@pikku/mantine": "^0.12.12",
    "@pikku/react": "^0.12.9",
    "@pikku/schema-cfworker": "^0.12.6",
    "ai": "^6.0.248"
  },
  "devDependencies": {
    "@pikku/cli": "0.12.137",
    "@types/node": "^22.20.1",
    "oxfmt": "^0.53.0",
    "oxlint": "^1.78.0"
  },
  "overrides": {
    "@pikku/cli": "0.12.137",
    "@pikku/core": "0.12.104",
    "@pikku/deploy": "0.12.7",
    "@pikku/fetch": "0.12.10",
    "@pikku/knowledge": "0.12.11",
    "@pikku/kysely": "0.13.24",
    "@pikku/ws": "0.12.9"
  },
  "packageManager": "bun@1.4.0"
}
