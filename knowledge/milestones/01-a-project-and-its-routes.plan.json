  "functions": {
    "kind": "built",
    "description": "Create and read a project, and declare the routes it tracks. Every one is scoped to the caller's organisation in its permissions field, never in a screen and never in the CLI.",
    "items": [
      {
        "name": "createProject",
        "description": "Create a project for the organisation the caller belongs to, seeding its three viewports.",
        "pass": 1,
        "scopes": [],
        "permission": "isOrganizationMember"
      },
      {
        "name": "listProjects",
        "description": "The caller's organisation's projects, and no others.",
        "pass": 1,
        "scopes": [],
        "permission": "isOrganizationMember"
      },
      {
        "name": "getProject",
        "description": "One project with its viewports, refused to anyone outside its organisation.",
        "pass": 1,
        "scopes": [],
        "permission": "canReachProject"
      },
      {
        "name": "declareRoutes",
        "description": "Upsert the routes a project tracks, by key \u2014 what the CLI's init calls, so the route inventory is reviewable in the consuming repo.",
        "pass": 1,
        "scopes": [],
        "permission": "canReachProject"
      },
      {
        "name": "listRoutes",
        "description": "A project's routes with their coverage state: legacy has it, legacy lacks it, or nobody has said.",
        "pass": 1,
        "scopes": [],
        "permission": "canReachProject"
      },
      {
        "name": "deleteProject",
        "description": "Delete a project and everything hanging off it. Exists in this milestone because the cascade is declared here, and a cascade nobody can trigger cannot be proven.",
        "pass": 1,
        "scopes": [],
        "permission": "canReachProject"
      }
    ]
  },
  "roles": {
    "kind": "built",
    "description": "One role. Organisation membership carries tenancy, and Better Auth's organisation plugin brings its own owner/admin/member roles for invitations.",
    "items": [
      {
        "name": "engineer",
        "description": "Runs a rebuild \u2014 declares the screens it tracks, pushes screenshots, reads the report",
        "app": "app"
      }
    ]
  },
  "scopes": {
    "kind": "n/a",
    "description": "No scopes. Access is organisation membership and project ownership, both resolved from the session against the row being reached."
  },
  "ui": {
    "kind": "built",
    "description": "Two screens: the projects a person has, and one project's routes with their coverage state.",
    "items": [
      {
        "route": "/app/projects",
        "description": "The caller's projects, and the form that creates one.",
        "pass": 1,
        "scenarios": [
          "mayaDeclaresARouteScenario"
        ]
      },
      {
        "route": "/app/projects/$projectId",
        "description": "One project's routes, each showing whether legacy has the screen, lacks it, or has not been mapped.",
        "pass": 1,
        "scenarios": [
          "mayaDeclaresARouteScenario",
          "rafiCannotReachAnotherOrgsProjectScenario"
        ]
      }
    ]
  },
  "scenarios": {
