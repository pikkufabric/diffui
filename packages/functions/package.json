{
  "name": "@project/functions",
  "version": "0.0.1",
  "private": true,
  "type": "module",
  "imports": {
    "#pikku/*.js": "./.pikku/*.ts",
    "#pikku/*": "./.pikku/*/index.ts"
  },
  "scripts": {
    "//tsc": "No tsconfig of its own: the root tsconfig.json is the backend's, and it is found by directory lookup from here — which is also how `fabric verify` runs it. Without this script `bun run --filter '*' tsc` matches on script NAME and silently skips the whole backend.",
    "tsc": "tsc --noEmit",
    "db:types": "pikku db types"
  },
  "dependencies": {
    "@ai-sdk/openai": "^3.0.65",
    "@ai-sdk/openai-compatible": "^2.0.48",
    "@better-auth/api-key": "^1.7.5",
    "@pikku/addon-admin": "^0.12.6",
    "@pikku/addon-console": "^0.12.54",
    "@pikku/ai-vercel": "^0.12.14",
    "@pikku/better-auth": "^0.12.44",
    "@pikku/core": "^0.12.118",
    "@pikku/kysely": "^0.13.27",
    "@pikku/schema-cfworker": "^0.12.7",
    "@standard-schema/spec": "^1.1.0",
    "ai": "^6.0.0",
    "better-auth": "^1.6.18",
    "kysely": "^0.29.0",
    "pixelmatch": "^7.2.0",
    "pngjs": "^7.0.0",
    "tsx": "^4.21.0",
    "zod": "^4.3.6"
  },
  "devDependencies": {
    "@pikku/playwright": "^0.12.83",
    "@playwright/test": "^1.50.0",
    "@types/node": "^22",
    "@types/pngjs": "^6.0.5",
    "typescript": "^5.9.3"
  }
}
